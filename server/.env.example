# Copy to .env.local for local development. On Vercel, add these in Project Settings → Environment Variables.
# Never put real values in this file: it is committed to git.

# Supabase dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# aistudio.google.com → API keys
GEMINI_API_KEY=

# Optional model overrides (defaults are in lib/shared/ai.ts)
AI_TEXT_MODEL=
AI_IMAGE_MODEL=
AI_AUDIO_MODEL=

# Morning email (optional). DAILY_CRON_TOKEN: any long random string you make up.
DAILY_CRON_TOKEN=
# Gmail SMTP: your Gmail address and a Google app password (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender address; leave empty to use SMTP_USER. With Gmail it must be that account or a verified alias.
EMAIL_FROM=
